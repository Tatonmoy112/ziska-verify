<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing of the app is backed up (the login
     session and the phone ID stay on this phone; final.md Section 12.1). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
